{
  "name": "treegger",
  "version": "0.1.0",
  "description": "A small reactive DOM library with HTML templates and JSX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/treegger.browser.min.js",
  "jsdelivr": "./dist/treegger.browser.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "reactive",
    "dom",
    "jsx",
    "signals",
    "html-templates"
  ],
  "scripts": {
    "build:package": "npm run build:package:module && npm run build:package:browser && npm run build:package:types",
    "build:package:module": "rolldown -c rolldown.module.config.mjs",
    "build:package:browser": "rolldown -c rolldown.browser.config.mjs",
    "build:package:types": "rolldown -c rolldown.types.config.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:watch": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "markdown-it": "^15.0.3",
    "rolldown": "1.2.15",
    "rolldown-plugin-dts": "^0.28.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
