{
  "name": "treegger",
  "version": "0.2.0",
  "description": "A small reactive DOM library with HTML templates and JSX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/treegger.browser.min.js",
  "jsdelivr": "./dist/treegger.browser.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "reactive",
    "dom",
    "jsx",
    "signals",
    "html-templates"
  ],
  "scripts": {
    "package:build": "npm run package:build:module && npm run package:build:browser && npm run package:build:types",
    "package:build:module": "rolldown -c rolldown.module.config.mjs",
    "package:build:browser": "rolldown -c rolldown.browser.config.mjs",
    "package:build:types": "rolldown -c rolldown.types.config.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "serve docs/web/dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:watch": "tsc -p tsconfig.json --watch",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "jsdom": "^29.1.1",
    "markdown-it": "^15.0.3",
    "oxlint": "^1.89.0",
    "rolldown": "1.2.15",
    "rolldown-plugin-dts": "^0.28.8",
    "serve": "^14.2.6",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
