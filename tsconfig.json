{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "treegger",
    "paths": {
      "treegger": ["./src/index.ts"],
      "treegger/jsx-runtime": ["./src/jsx-runtime.ts"],
      "treegger/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts", "test/types.tsx", "examples/**/*.tsx"]
}
